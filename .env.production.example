# Environment
ENVIRONMENT=production

# Domain Configuration
DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# Server Configuration
API_PORT=8080
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_SHUTDOWN_TIMEOUT=30

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=suproxy_prod
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE
DB_NAME=suproxy_prod
DB_SSLMODE=require
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=10
DB_CONN_MAX_IDLE_TIME=20

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# JWT Configuration
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_RANDOM_STRING_HERE
JWT_ACCESS_EXPIRY=15
JWT_REFRESH_EXPIRY=168
JWT_ISSUER=suproxy-backend

# Xray Configuration
XRAY_USE_MOCK=false
XRAY_BINARY_PATH=/usr/local/bin/xray
XRAY_CONFIG_DIR=/etc/xray
XRAY_LOG_DIR=/var/log/xray
XRAY_BACKUP_DIR=/var/backups/xray
XRAY_INSTALL_DIR=/opt/xray

# Metrics Configuration
METRICS_ENABLED=true
METRICS_INTERVAL=30

# Docker Registry (Production)
DOCKER_REGISTRY=ghcr.io/tuncay005-png/suproxy-backend
VERSION=latest

# Monitoring (Production)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_SECURE_GRAFANA_PASSWORD

# Traefik Dashboard Authentication
# Generate with: htpasswd -nb admin your_password
# Example: admin:$apr1$h7w3l9xc$X8F9Z2K5Y6M3N1B4V7C8D0
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$CHANGEME$$CHANGEME

# Monitoring Tools Authentication (Prometheus)
# Generate with: htpasswd -nb admin your_password
MONITORING_AUTH=admin:$$apr1$$CHANGEME$$CHANGEME

# Cookie Security (HTTPS)
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
